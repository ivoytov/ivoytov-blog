---
import { getCollection, render } from "astro:content";
import Container from "@components/Container.astro";
import PageLayout from "@layouts/PageLayout.astro";
import ArrowCard from "@components/ArrowCard.astro";
import Link from "@components/Link.astro";
import { SITE, HOME, SOCIALS } from "@consts";
import { dateRange } from "@lib/utils";

const blog = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, SITE.NUM_POSTS_ON_HOMEPAGE);

const work = await Promise.all(
  (await getCollection("work"))
    .sort((a, b) => b.data.dateStart.valueOf() - a.data.dateStart.valueOf())
    .slice(0, SITE.NUM_WORKS_ON_HOMEPAGE)
    .map(async (item) => {
      const { Content } = await render(item);
      return { ...item, Content };
    }),
);
---

<PageLayout title={HOME.TITLE} description={HOME.DESCRIPTION}>
  <Container>
    <h4 class="animate font-semibold text-black dark:text-white">
      Hi, I'm Ilya <span class="text-xl">👋🏻</span>
    </h4>
    <div class="space-y-16">
      <section>
        <article class="space-y-4">
          <p class="animate">
            I'm a Senior Vice President at Lazard Asset Management, working on quant research.
            I develop alpha models used to trade global equities in long-only, medium-turnover strategies.
          </p>
          <p class="animate">
            Previously, I spent thirteen years as Head of Research at Vector Capital in San Francisco,
            focused on special situations and catalyst-driven investments in high-yield and syndicated-loan markets.
            I started my career in investment banking at JPMorgan.
          </p>
          <p class="animate">
            I live in New York City, run with the
            <Link href="https://www.newyorkharriers.com" external>New York Harriers</Link>,
            and surf in the Rockaways.
          </p>
        </article>
      </section>

      <section class="animate space-y-6">
        <div class="flex flex-wrap gap-y-2 items-center justify-between">
          <h5 class="font-semibold text-black dark:text-white">Latest posts</h5>
          <Link href="/blog">See all posts</Link>
        </div>
        <ul class="flex flex-col gap-4">
          {blog.map((post) => <li><ArrowCard entry={post} /></li>)}
        </ul>
      </section>

      <section class="animate space-y-6">
        <div class="flex flex-wrap gap-y-2 items-center justify-between">
          <h5 class="font-semibold text-black dark:text-white">Work Experience</h5>
          <Link href="/work">See all work</Link>
        </div>
        <ul class="flex flex-col space-y-4">
          {work.map((entry) => (
            <li>
              <div class="text-sm opacity-75">
                {dateRange(entry.data.dateStart, entry.data.dateEnd)}
              </div>
              <div class="font-semibold text-black dark:text-white">
                {entry.data.company}
              </div>
              <div class="text-sm opacity-75">{entry.data.role}</div>
              <article><entry.Content /></article>
            </li>
          ))}
        </ul>
      </section>

      <section class="animate space-y-4">
        <h5 class="font-semibold text-black dark:text-white">Let's Connect</h5>
        <ul class="flex flex-wrap gap-2">
          {SOCIALS.map((social) => (
            <li class="flex gap-x-2 text-nowrap">
              <Link href={social.HREF} external aria-label={`${SITE.NAME} on ${social.NAME}`}>
                {social.NAME}
              </Link>
              {"/"}
            </li>
          ))}
          <li class="line-clamp-1">
            <Link href={`mailto:${SITE.EMAIL}`} aria-label={`Email ${SITE.NAME}`}>
              {SITE.EMAIL}
            </Link>
          </li>
        </ul>
      </section>
    </div>
  </Container>
</PageLayout>
